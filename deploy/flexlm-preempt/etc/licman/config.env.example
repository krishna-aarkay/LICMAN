# /etc/licman/config.env  — source of truth for flexlm-preempt
# Sourced by both /usr/local/bin/tool-wrapper and /usr/local/sbin/licman-preempt.
# All keys are plain bash; no quoting tricks needed for ordinary paths.

# ---- FlexLM ---------------------------------------------------------------
# Path to lmutil. Adjust for your install.
LMUTIL="/usr/local/flexlm/lmutil"

# Primary license server (port@host). For multi-server, use redundant triple:
#   LIC="5280@licsrv01:5280@licsrv02:5280@licsrv03"
LIC="5280@licsrv01"

# ---- Tool map -------------------------------------------------------------
# Key   = wrapper symlink name in /usr/local/bin/  (i.e. what users type)
# Value = "<FlexLM feature name>:<absolute path to the REAL binary>"
#
# Add one line per tool you want preemption for. The feature name MUST match
# `lmutil lmstat -a` exactly (case-sensitive).
declare -A TOOL_MAP=(
  [innovus]="innovus:/opt/cadence/innovus/bin/innovus.real"
  [virtuoso]="Virtuoso_L:/opt/cadence/virtuoso/bin/virtuoso.real"
  [genus]="Genus:/opt/cadence/genus/bin/genus.real"
  [tempus]="Tempus:/opt/cadence/tempus/bin/tempus.real"
  [vcs]="VCS-RuntimeNetlist:/opt/synopsys/vcs/bin/vcs.real"
  [dc_shell]="DesignCompiler:/opt/synopsys/syn/bin/dc_shell.real"
  [primetime]="PrimeTime:/opt/synopsys/pts/bin/primetime.real"
  [calibre]="Calibre_DRC:/opt/mentor/calibre/bin/calibre.real"
  [questa]="Questa_Sim:/opt/mentor/questa/bin/questa.real"
)

# ---- Behaviour ------------------------------------------------------------
# Seconds to wait after lmremove before launching real binary. Some vendors
# need 2-5s for the daemon to free the slot internally.
SETTLE_SEC=3

# Where the wrapper writes its log. Logrotate-friendly path.
LOG="/var/log/licman/wrapper.log"

# Where the per-feature priority lists live.
LICMAN_DIR="/etc/licman"

# Where the wait-flag is touched while a priority user is in-flight.
WAIT_DIR="/var/lib/licman"

# If 1, low-priority users running the wrapper will EXIT EARLY (code 2) when
# a priority user is currently waiting for the same feature. Set to 0 for the
# more typical "low-priority just gets kicked" behaviour.
BACK_OFF_FOR_PRIORITY=0

# ---- Remote preempt (optional) -------------------------------------------
# Set this if `lmremove` from workstations is rejected by your FlexLM config.
# When set, the wrapper SSHes into this host to run licman-preempt.
# Leave empty to use local sudo.
#PREEMPT_VIA_SSH="licadmin@licsrv01"
PREEMPT_VIA_SSH=""

# SSH key used for the above. Must be 0600, readable by every user that may
# preempt (i.e. everyone in the priority-users group). One option: put the
# private key in /etc/licman/ with group=priority-users mode=0640.
SSH_KEY="/etc/licman/preempt.key"
