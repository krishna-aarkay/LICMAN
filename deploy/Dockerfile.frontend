FROM node:20-alpine AS build

WORKDIR /build

# Cache deps layer
COPY frontend/package.json frontend/yarn.lock* ./
RUN yarn install --frozen-lockfile --network-timeout 600000 || yarn install --network-timeout 600000

COPY frontend/ ./
# Inject backend URL at build time. Empty means "same origin" (preferred with nginx proxy).
ARG REACT_APP_BACKEND_URL=""
ENV REACT_APP_BACKEND_URL=${REACT_APP_BACKEND_URL}
RUN yarn build

# --- Runtime ---
FROM nginx:1.27-alpine
RUN rm -rf /usr/share/nginx/html/*
COPY --from=build /build/build /usr/share/nginx/html
# A minimal per-container nginx (the outer reverse-proxy nginx still handles TLS).
RUN printf 'server {\n  listen 80 default_server;\n  root /usr/share/nginx/html;\n  index index.html;\n  location / { try_files $uri /index.html; }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
