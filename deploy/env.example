# --- LICMAN deployment env template ---
# Copy this to `.env` (same folder as docker-compose.yml) and edit values below.
#   cp env.example .env

# Mongo
MONGO_INITDB_ROOT_USERNAME=licman
MONGO_INITDB_ROOT_PASSWORD=change-me-please
MONGO_DB_NAME=licman

# Backend
# DEMO_MODE=1 will auto-seed 3 demo servers (10.10.11.111/112/113) on first boot.
# Set to 0 for a clean prod install.
DEMO_MODE=0
CORS_ORIGINS=*

# Public URL of this web app — used by the React frontend to call /api.
# In nginx-proxy mode both frontend and backend are reached via the same origin,
# so leave this blank (or point to the nginx host).
REACT_APP_BACKEND_URL=

# TLS — leave blank to use the auto-generated self-signed cert installed by install-rhel9.sh.
# To bring your own:
#   TLS_CERT_FILE=/opt/licman/deploy/nginx/ssl/server.crt
#   TLS_KEY_FILE=/opt/licman/deploy/nginx/ssl/server.key

# Timezone (optional)
TZ=Asia/Kolkata
