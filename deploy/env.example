# --- LICMAN deployment env template ---
# Copy this to `.env` (same folder as docker-compose.yml) and edit values below.
#   cp env.example .env

# === Mongo ===
MONGO_INITDB_ROOT_USERNAME=licman
MONGO_INITDB_ROOT_PASSWORD=change-me-please
MONGO_DB_NAME=licman

# === Backend behavior ===
# DEMO_MODE=1 auto-seeds 3 demo servers; set 0 for prod.
DEMO_MODE=0
CORS_ORIGINS=*

# Auto-sync background loop: how often (seconds) to pull lmstat from every SSH-enabled server.
# Set 0 to disable.
SYNC_INTERVAL_SECONDS=60

# Audit log retention (days). Older entries auto-deleted by MongoDB TTL index.
AUDIT_TTL_DAYS=90

# === Secrets (auto-generated by install-rhel9.sh if blank) ===
# JWT signing secret. Generate manually:
#   python3 -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=

# Fernet key for at-rest encryption of SSH keys & SMTP passwords. Generate manually:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# === TLS / cookies ===
# Set COOKIE_SECURE=true when you serve LICMAN only over HTTPS (recommended for prod).
COOKIE_SECURE=false

# Public URL of this web app — leave blank when using the bundled nginx reverse proxy.
REACT_APP_BACKEND_URL=

# Timezone
TZ=Asia/Kolkata
