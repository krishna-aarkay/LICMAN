# --- LICMAN deployment env template ---
# Copy this to `.env` (same folder as docker-compose.yml) and edit values below.
#   cp env.example .env

# Mongo
MONGO_INITDB_ROOT_USERNAME=licman
MONGO_INITDB_ROOT_PASSWORD=change-me-please
MONGO_DB_NAME=licman

# Backend
# DEMO_MODE=1 will auto-seed 3 demo servers on first boot. Set to 0 for prod.
DEMO_MODE=0
CORS_ORIGINS=*

# JWT signing secret — MUST be a long random string. install-rhel9.sh auto-generates one if missing.
# Generate manually with:  python3 -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=

# Public URL of this web app — leave blank when using the nginx reverse proxy on same origin.
REACT_APP_BACKEND_URL=

# Timezone
TZ=Asia/Kolkata
